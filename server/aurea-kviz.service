# Единственное описание службы. В установщик оно попадает целиком
# (scripts/build-installer.sh), поэтому разойтись копиям неоткуда.
[Unit]
Description=AUREA · приёмник заявок с квиз-лендинга
Documentation=https://github.com/kirill-design367/kviz
After=network-online.target
Wants=network-online.target
# Иначе серия быстрых падений загоняет юнит в failed насовсем,
# и сервис не поднимется даже после того, как причина устранена.
StartLimitIntervalSec=0

[Service]
Type=simple
User=aureakviz
Group=aureakviz
WorkingDirectory=/opt/aurea-kviz
ExecStart=/usr/bin/env python3 /opt/aurea-kviz/app.py
EnvironmentFile=/etc/aurea-kviz/kviz.env
Restart=always
RestartSec=3
SyslogIdentifier=aurea-kviz

# Изоляция: службе нужен только свой каталог данных и сеть.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
ReadWritePaths=/var/lib/aurea-kviz
# AF_UNIX обязателен: без него ломается резолвер, а выглядит это как «нет сети».
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
